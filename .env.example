# Configurações do Firebase
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Chave da RAWG API (Obtenha gratuitamente em https://rawg.io/apidocs)
VITE_RAWG_API_KEY=your_rawg_api_key

# Chave da YouTube Data API v3 (Obtenha no Google Cloud Console)
VITE_YOUTUBE_API_KEY=your_youtube_api_key

# Repositório Privado de Músicas no GitHub (Álbuns e Coleções)
# Exemplo: seu-usuario/GamerVault-Tracks
VITE_GITHUB_TRACKS_REPO=
# Token clássico com escopo 'repo' (começa com ghp_...)
VITE_GITHUB_TRACKS_TOKEN=

# Dropbox (Automação de Release)
# Opção A: Token de acesso direto (temporário - expira em 4h)
DROPBOX_ACCESS_TOKEN=
# Opção B: Refresh Token (recomendado - nunca expira)
DROPBOX_REFRESH_TOKEN=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

